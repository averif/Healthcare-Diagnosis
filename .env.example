# Settings for `docker compose up` (copy to .env and fill in; never commit .env).
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=
JWT_SECRET_KEY=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 1 = create demo accounts and ~60 sample predictions on first start (for the viva demo)
SEED_DEMO=1
# Password for the demo accounts created when SEED_DEMO=1
DEMO_PASSWORD=

# Optional AI assistant (offline rule-based answers when empty)
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
