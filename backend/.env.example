FLASK_APP=wsgi
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-32chars+
JWT_SECRET_KEY=change-me-to-another-long-random-string-32+

# Leave unset for SQLite (backend/instance/healthcare.db). For MySQL:
# DATABASE_URL=mysql+pymysql://mediassist:password@localhost:3306/mediassist

CORS_ORIGINS=http://localhost:5173

# AI clinical assistant: auto | nvidia | claude | rules
# auto = NVIDIA if NVIDIA_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else offline rules
ASSISTANT_PROVIDER=auto
# NVIDIA API catalog key from https://build.nvidia.com (can also live in the project-root .env)
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_REASONING=0   # 1 = let the model reason first (much slower, rarely better here)
# Paste your key from https://console.anthropic.com/ (never commit .env)
# ANTHROPIC_API_KEY=
# Model used by the assistant. claude-opus-5-5 is the default; claude-haiku-5-5 is much cheaper.
# ASSISTANT_MODEL=claude-opus-5-5

# Password for accounts created by `flask seed` (local demo only)
DEMO_PASSWORD=Demo@12345

# Doctor proof-of-registration uploads (PDF/JPG/PNG, max 5 MB), served only to admins.
# Default: backend/instance/doctor_documents. On Render the disk is ephemeral: mount a
# persistent disk and point this at it, or uploaded documents are lost on every deploy.
# DOCTOR_DOCS_DIR=/var/data/doctor_documents
