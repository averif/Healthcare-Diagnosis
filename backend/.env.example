FLASK_APP=wsgi
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-32chars+
JWT_SECRET_KEY=change-me-to-another-long-random-string-32+

# Leave unset for SQLite (backend/instance/healthcare.db). For MySQL:
# DATABASE_URL=mysql+pymysql://mediassist:password@localhost:3306/mediassist

CORS_ORIGINS=http://localhost:5173

# AI clinical assistant: rules | claude | gemini
ASSISTANT_PROVIDER=rules
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Password for accounts created by `flask seed` (local demo only)
DEMO_PASSWORD=Demo@12345
